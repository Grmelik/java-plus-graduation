server:
  port: 8080

spring:
  application:
    name: gateway-server
  cloud:
    config:
      enabled: false
    gateway:
      discovery:
        locator:
          enabled: true
          lower-case-service-id: true
      routes:
        - id: user-service
          uri: lb://USER-SERVICE
          predicates:
            - Path=/admin/users/**, /users/**

        - id: event-service
          uri: lb://EVENT-SERVICE
          predicates:
            - Path=/admin/events/**, /users/*/events/**, /events/**, /admin/categories/**, /categories/**, /admin/compilations/**, /compilations/**

        - id: request-service
          uri: lb://REQUEST-SERVICE
          predicates:
            - Path=/users/*/requests/**

        - id: comment-service
          uri: lb://COMMENT-SERVICE
          predicates:
            - Path=/comments/**

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
  instance:
    prefer-ip-address: true

management:
  endpoints:
    web:
      exposure:
        include: gateway, health, info, routes